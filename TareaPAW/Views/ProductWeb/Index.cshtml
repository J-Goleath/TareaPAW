@model IEnumerable<PAW.Models.DTO.ProductDTO>

@{
    ViewData["Title"] = "Productos";
}

<div class="container-fluid mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="mb-0">Lista de Productos</h1>
        <button type="button" class="btn btn-success">Agregar Producto</button>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-warning">
            No hay productos disponibles.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-dark table-striped table-hover align-middle">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Producto</th>
                        <th>Descripción</th>
                        <th>Rating</th>
                        <th>Categoría</th>
                        <th>Inventario</th>
                        <th>Proveedor</th>
                        <th>Última modificación</th>
                        <th>Modificado por</th>
                        <th>Creado por</th>
                        <th>Acciones</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                    <tr>
                        <td>@item.ProductId</td>
                        <td>@item.ProductName</td>
                        <td>@item.Description</td>
                        <td class="text-nowrap">
                            @if (item.Rating.HasValue)
                            {
                                var stars = Math.Clamp((int)Math.Round(item.Rating.Value, MidpointRounding.AwayFromZero), 0, 5);
                                <span class="text-warning">@(new string('★', stars))@(new string('☆', 5 - stars))</span>
                                <small class="text-light ms-1">@item.Rating.Value.ToString("0.0")</small>
                            }
                        </td>
                        <td>@item.CategoryId</td>
                        <td>@item.InventoryId</td>
                        <td>@item.SupplierId</td>
                        <td>@item.LastModified?.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>@item.ModifiedBy</td>
                        <td>@item.CreatedBy</td>
                        <td class="text-nowrap">
                            <button type="button" class="btn btn-sm btn-warning">Editar</button>
                            <button type="button" class="btn btn-sm btn-info">Detalles</button>
                            <button type="button" class="btn btn-sm btn-danger">Eliminar</button>
                        </td>
                    </tr>
                    }
                </tbody>
            </table>
        </div>
    }

</div>
