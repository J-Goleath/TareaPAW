@model IEnumerable<PAW.Models.DTO.InventoryDTO>

@{
    ViewData["Title"] = "Inventario";
}

<div class="container-fluid mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="mb-0">Lista de Inventario</h1>
        <button type="button" class="btn btn-success">Agregar Inventario</button>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-warning">
            No hay registros de inventario disponibles.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-dark table-striped table-hover align-middle">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Precio unitario</th>
                        <th>Unidades en stock</th>
                        <th>Producto</th>
                        <th>Fecha de ingreso</th>
                        <th>Última actualización</th>
                        <th>Modificado por</th>
                        <th>Acciones</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                    <tr>
                        <td>@item.InventoryId</td>
                        <td>@item.UnitPrice?.ToString("N2")</td>
                        <td>@item.UnitsInStock</td>
                        <td>@item.ProductId</td>
                        <td>@item.DateAdded?.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>@item.LastUpdated?.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>@item.ModifiedBy</td>
                        <td class="text-nowrap">
                            <button type="button" class="btn btn-sm btn-warning">Editar</button>
                            <button type="button" class="btn btn-sm btn-info">Detalles</button>
                            <button type="button" class="btn btn-sm btn-danger">Eliminar</button>
                        </td>
                    </tr>
                    }
                </tbody>
            </table>
        </div>
    }

</div>
