<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TareaPAW</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TareaPAW.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">TareaPAW</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-dark" href="#" id="entidadesDropdown" role="button"
                               data-bs-toggle="dropdown" aria-expanded="false">Entidades</a>
                            <ul class="dropdown-menu" aria-labelledby="entidadesDropdown">
                                <li><a class="dropdown-item" asp-area="" asp-controller="ProductWeb" asp-action="Index">Productos</a></li>
                                <li><a class="dropdown-item" asp-area="" asp-controller="CategoryWeb" asp-action="Index">Categorías</a></li>
                                <li><a class="dropdown-item" asp-area="" asp-controller="ComponentWeb" asp-action="Index">Componentes</a></li>
                                <li><a class="dropdown-item" asp-area="" asp-controller="InventoryWeb" asp-action="Index">Inventario</a></li>
                                <li><a class="dropdown-item" asp-area="" asp-controller="NotificationWeb" asp-action="Index">Notificaciones</a></li>
                                <li><a class="dropdown-item" asp-area="" asp-controller="RoleWeb" asp-action="Index">Roles</a></li>
                                <li><a class="dropdown-item" asp-area="" asp-controller="SupplierWeb" asp-action="Index">Proveedores</a></li>
                                <li><a class="dropdown-item" asp-area="" asp-controller="PawTaskWeb" asp-action="Index">Tareas</a></li>
                                <li><a class="dropdown-item" asp-area="" asp-controller="UserWeb" asp-action="Index">Usuarios</a></li>
                                <li><a class="dropdown-item" asp-area="" asp-controller="UserActionWeb" asp-action="Index">Acciones de usuario</a></li>
                                <li><a class="dropdown-item" asp-area="" asp-controller="UserRoleWeb" asp-action="Index">Roles de usuario</a></li>
                            </ul>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - TareaPAW - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
