@model TaskDTO
@{
    ViewData["Title"] = "Detalle de tarea";
}

<div class="tasks-page mt-4">
    <h2>Tarea #@Model.Id</h2>

    <div class="card shadow-sm" style="max-width: 720px;">
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-4">Nombre</dt>
                <dd class="col-sm-8">@Model.Name</dd>

                <dt class="col-sm-4">Descripción</dt>
                <dd class="col-sm-8">@Model.Description</dd>

                <dt class="col-sm-4">Estado</dt>
                <dd class="col-sm-8"><partial name="_StatusBadge" model="Model.Status" /></dd>

                <dt class="col-sm-4">Fecha límite</dt>
                <dd class="col-sm-8">@Model.DueDate?.ToString("dd/MM/yyyy")</dd>

                <dt class="col-sm-4">Creada</dt>
                <dd class="col-sm-8">@Model.CreatedAt?.ToString("dd/MM/yyyy HH:mm")</dd>

                <dt class="col-sm-4">Última modificación</dt>
                <dd class="col-sm-8">@Model.LastModified?.ToString("dd/MM/yyyy HH:mm")</dd>

                <dt class="col-sm-4">Modificada por</dt>
                <dd class="col-sm-8">@Model.ModifiedBy</dd>
            </dl>
        </div>
    </div>

    <div class="mt-3">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Editar</a>
        <a asp-action="Index" class="btn btn-outline-secondary">Volver</a>
    </div>
</div>
