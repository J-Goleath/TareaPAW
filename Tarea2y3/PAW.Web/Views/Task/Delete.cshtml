@model TaskDTO
@{
    ViewData["Title"] = "Borrar tarea";
}

<div class="tasks-page mt-4">
    <h2 class="text-danger">¿Borrar esta tarea?</h2>

    <div class="card border-danger shadow-sm" style="max-width: 720px;">
        <div class="card-body">
            <h5>@Model.Name</h5>
            <p class="mb-1">@Model.Description</p>
            <partial name="_StatusBadge" model="Model.Status" />
        </div>
    </div>

    <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="mt-3">
        <button type="submit" class="btn btn-danger">Sí, borrar</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
    </form>
</div>
